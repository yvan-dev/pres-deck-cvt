# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/bmad-pipeline/bmad_pipeline.egg-info/
/bmad-pipeline/serve-*.log
/bmad-pipeline/serve-*.err.log
/bmad-pipeline/.claude/

# misc
.DS_Store
*.pem
__pycache__/
*.py[cod]
.forge/
codex-native-smoke.txt
/bmad-pipeline/codex-smoke.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch (brand assets, screenshots, working sources)
/.local/
